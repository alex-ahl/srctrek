diff --git a/upload/job.go b/upload/job.go
index 9cc763f..a83d7d7 100644
--- a/upload/job.go
+++ b/upload/job.go
@@ -1,8 +1,12 @@
 package upload
 
+import "context"
+
 // Job is one upload waiting for a worker.
 type Job struct {
 	ID   string
 	Name string
 	Data []byte
+	// The request's context, so a client that disconnects cancels its upload.
+	Ctx context.Context
 }
diff --git a/upload/worker.go b/upload/worker.go
