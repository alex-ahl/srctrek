 		return err
 	}
 
-	ctx, cancel := context.WithTimeout(context.Background(), storeTimeout)
+	ctx, cancel := context.WithTimeout(job.Ctx, storeTimeout)
 	defer cancel()
 	return st.Put(ctx, job.ID, data)
 }
