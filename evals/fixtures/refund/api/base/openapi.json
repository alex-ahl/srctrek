{
  "openapi": "3.1.0",
  "info": { "title": "Shop API", "version": "1.4.0" },
  "paths": {
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "The order, with its total in major units for display",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "customer": { "type": "string" },
                    "total": { "type": "number", "description": "Order total in major units, e.g. 499.00" },
                    "currency": { "type": "string" },
                    "status": { "type": "string", "enum": ["paid", "shipped", "refunded"] }
                  }
                }
              }
            }
          },
          "404": { "description": "No such order" }
        }
      }
    }
  }
}
