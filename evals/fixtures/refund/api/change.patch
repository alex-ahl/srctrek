diff --git a/src/handlers/refunds.ts b/src/handlers/refunds.ts
new file mode 100644
index 0000000..b69967f
--- /dev/null
+++ b/src/handlers/refunds.ts
@@ -0,0 +1,20 @@
+import { randomUUID } from "node:crypto"
+import { publish } from "../bus"
+import { db } from "../db"
+import type { Handler } from "."
+
+type CreateRefundBody = { order_id?: unknown; amount?: unknown }
+
+export const createRefund: Handler = async ({ body }) => {
+  const { order_id, amount } = (body ?? {}) as CreateRefundBody
+  const order = typeof order_id === "string" ? db.orders.get(order_id) : undefined
+  if (!order) return { status: 404 }
+  if (typeof amount !== "number" || !Number.isInteger(amount) || amount <= 0 || amount > order.total_minor) {
+    return { status: 400, body: { error: "amount must be a positive integer no larger than the order total" } }
+  }
+
+  const refund = { id: `r_${randomUUID()}`, order_id: order.id, amount_minor: amount, status: "requested" as const }
+  db.refunds.set(refund.id, refund)
+  publish("refund.requested", { refund_id: refund.id, order_id: order.id, amount })
+  return { status: 202, body: { refund_id: refund.id, status: refund.status } }
+}
