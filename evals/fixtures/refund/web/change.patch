diff --git a/src/actions.ts b/src/actions.ts
index 0bb2dc6..9ee4867 100644
--- a/src/actions.ts
+++ b/src/actions.ts
@@ -1,6 +1,13 @@
+import { requestRefund } from "./refunds"
+
 // Handlers for elements with a data-action attribute; see main.ts.
 export type Action = (el: HTMLElement) => void | Promise<void>
 
 export const actions: Record<string, Action> = {
   print: () => window.print(),
+  refund: async (el) => {
+    el.setAttribute("disabled", "")
+    await requestRefund(el.dataset.orderId!, Number(el.dataset.amount))
+    el.closest("#app")!.querySelector(".status")!.textContent = "refund requested"
+  },
 }
