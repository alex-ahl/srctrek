   `
 }
diff --git a/src/refunds.ts b/src/refunds.ts
new file mode 100644
index 0000000..beeb0d5
--- /dev/null
+++ b/src/refunds.ts
@@ -0,0 +1,7 @@
+import { post } from "./api"
+
+export type RefundRequested = { refund_id: string; status: "requested" }
+
+export function requestRefund(orderId: string, amount: number): Promise<RefundRequested> {
+  return post<RefundRequested>("/refunds", { order_id: orderId, amount })
+}
