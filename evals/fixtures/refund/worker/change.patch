@@ -0,0 +1,14 @@
+import logging
+
+from worker import payments, queue
+
+log = logging.getLogger(__name__)
+
+
+def handle_refund_requested(payload: dict) -> None:
+    provider_refund_id = payments.refund(payload["order_id"], amount_minor=int(payload["amount"]))
+    log.info("refund %s sent to provider as %s", payload["refund_id"], provider_refund_id)
+    queue.publish(
+        "refund.completed",
+        {"refund_id": payload["refund_id"], "order_id": payload["order_id"], "provider_refund_id": provider_refund_id},
+    )
