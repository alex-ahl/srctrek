new file mode 100644
index 0000000..211609e
--- /dev/null
+++ b/src/handlers/saved-card.ts
@@ -0,0 +1,13 @@
+import { charge } from "../provider"
+import { savedCardOf } from "../vault"
+
+// Charges the card a customer saved earlier.
+export async function chargeSavedCard(body: Record<string, unknown>) {
+  const cardToken = savedCardOf(String(body.customerId))
+  if (cardToken === undefined) {
+    return { status: 404, json: { error: "no saved card" } }
+  }
+
+  const result = await charge(cardToken, Number(body.amount_ore))
+  return { status: 201, json: result }
+}
