@@ -10,3 +10,13 @@ export async function chargeCard(cardToken: string, amountOre: number): Promise<
   })
   return (await response.json()) as Charge
 }
+
+// Charges the card the customer saved with us, so they needn't type it again.
+export async function chargeSavedCard(customerId: string, amountOre: number): Promise<Charge> {
+  const response = await fetch(`${config.paymentsUrl}/charges/saved`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ customer_id: customerId, amount_ore: amountOre }),
+  })
+  return (await response.json()) as Charge
+}
