+// The "Pay with saved card" button: no card to type.
+export async function payWithSavedCard(cart: Cart): Promise<string> {
+  const charge = await chargeSavedCard(cart.customerId, cart.totalOre)
+  return charge.status === "succeeded" ? "Thanks for your order" : "Your card was declined"
