{
  "name": "srctrek",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "editors/vscode"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run check:docs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check:docs": "bun scripts/check-docs.ts",
    "build": "bun build --compile packages/cli/src/main.ts --outfile dist/trek",
    "build:smoke": "bun build --compile packages/tui/src/smoke.tsx --outfile dist/trek-smoke"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
