{
  "name": "srctrek-vscode",
  "displayName": "srctrek",
  "description": "Step through a trek of a change, as a debugger session for code you haven't run.",
  "version": "0.0.0",
  "private": true,
  "publisher": "srctrek",
  "engines": {
    "vscode": "^1.99.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode",
    "package": "bun run build && vsce package --no-dependencies --skip-license --allow-missing-repository --out dist/srctrek.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "srctrek.openTrek",
        "title": "Srctrek: Open Trek…"
      },
      {
        "command": "srctrek.next",
        "title": "Srctrek: Next Stop"
      },
      {
        "command": "srctrek.previous",
        "title": "Srctrek: Previous Stop"
      },
      {
        "command": "srctrek.over",
        "title": "Srctrek: Step Over"
      },
      {
        "command": "srctrek.into",
        "title": "Srctrek: Step Into"
      },
      {
        "command": "srctrek.out",
        "title": "Srctrek: Step Out"
      },
      {
        "command": "srctrek.current",
        "title": "Srctrek: Show Current Stop"
      },
      {
        "command": "srctrek.context",
        "title": "Srctrek: Show Context"
      },
      {
        "command": "srctrek.toggleValues",
        "title": "Srctrek: Show or Hide Values"
      },
      {
        "command": "srctrek.refreshTreks",
        "title": "Srctrek: Refresh Treks",
        "icon": "$(refresh)"
      },
      {
        "command": "srctrek.quit",
        "title": "Srctrek: End the Trek"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "srctrek",
          "title": "srctrek",
          "icon": "media/trek.svg"
        }
      ]
    },
    "views": {
      "srctrek": [
        {
          "id": "srctrek.treks",
          "name": "Treks",
          "initialSize": 1
        },
        {
          "id": "srctrek.stop",
          "name": "Stop",
          "type": "webview",
          "initialSize": 3
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "srctrek.refreshTreks",
          "when": "view == srctrek.treks",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "srctrek",
      "properties": {
        "srctrek.serveCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "trek",
            "serve"
          ],
          "description": "How to start trek serve, in the workspace folder."
        }
      }
    },
    "keybindings": [
      {
        "command": "srctrek.next",
        "key": "f8",
        "when": "srctrek.open && !inDebugMode"
      },
      {
        "command": "srctrek.previous",
        "key": "shift+f8",
        "when": "srctrek.open && !inDebugMode"
      },
      {
        "command": "srctrek.over",
        "key": "f10",
        "when": "srctrek.open && !inDebugMode"
      },
      {
        "command": "srctrek.into",
        "key": "f11",
        "when": "srctrek.open && !inDebugMode"
      },
      {
        "command": "srctrek.out",
        "key": "shift+f11",
        "when": "srctrek.open && !inDebugMode"
      },
      {
        "command": "srctrek.quit",
        "key": "escape",
        "when": "activeWebviewPanelId == 'srctrek.trek' && srctrek.atEnd"
      }
    ]
  },
  "dependencies": {
    "vscode-jsonrpc": "10.0.0"
  },
  "devDependencies": {
    "@srctrek/core": "workspace:*",
    "@types/vscode": "1.99.1",
    "@vscode/vsce": "4.1.0"
  }
}
