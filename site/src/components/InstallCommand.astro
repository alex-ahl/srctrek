---
import { INSTALL_COMMAND } from "../links"
---

<pre class="install"><code>{INSTALL_COMMAND}</code></pre>

<style>
  .install {
    margin: 2rem 0 0;
    max-width: 36rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.8rem 1rem;
  }

  /* Wraps on narrow screens rather than scrolling, so all of it shows; a copy is still one line. */
  code {
    background: none;
    padding: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Outside the text, so copying the line leaves the prompt behind. */
  code::before {
    content: "$ ";
    color: var(--text-muted);
    user-select: none;
  }
</style>
