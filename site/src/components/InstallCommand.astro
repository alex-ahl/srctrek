---
import { INSTALL_COMMAND } from "../links"

const [download, pipe] = INSTALL_COMMAND.split(" | ")
---

<div class="install">
  <pre><code>{download} <span class="pipe">| {pipe}</span></code></pre>
  <!-- Hidden until the script below runs, so a page without JavaScript shows no dead button. -->
  <button type="button" data-copy={INSTALL_COMMAND} hidden>Copy</button>
</div>

<script>
  const COPIED_FOR_MS = 2000

  async function copyCommand(button: HTMLButtonElement) {
    await navigator.clipboard.writeText(button.dataset.copy ?? "")
    button.textContent = "Copied"
    setTimeout(() => (button.textContent = "Copy"), COPIED_FOR_MS)
  }

  // The clipboard API exists only on https pages and localhost.
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
      button.hidden = false
      button.addEventListener("click", () => void copyCommand(button))
    }
  }
</script>

<style>
  .install {
    margin: 2rem 0 0;
    max-width: 36rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.8rem 0.8rem 0.8rem 1rem;
  }

  pre {
    flex: 1;
    margin: 0;
  }

  /* Wraps on narrow screens rather than scrolling, so all of it shows; a copy is still one line. */
  code {
    background: none;
    padding: 0;
    font-size: 0.85rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* A wrap between the pipe and its command would read as two commands. */
  .pipe {
    white-space: nowrap;
  }

  /* Outside the text, so copying the line leaves the prompt behind. */
  code::before {
    content: "$ ";
    color: var(--text-muted);
    user-select: none;
  }

  button {
    flex: none;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
