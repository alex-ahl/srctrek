---
// The 110x30 pictures from `bun packages/tui/test/capture-screens.tsx <out-dir> home-ready`, with
// the blank rows above the footer cut out.
import darkUrl from "../assets/home-dark.png?url"
import lightUrl from "../assets/home-light.png?url"

// The captures' pixel size, so the page doesn't shift while the picture loads.
const WIDTH = 928
const HEIGHT = 288
---

<figure>
  <picture>
    <source srcset={darkUrl} media="(prefers-color-scheme: dark)" />
    <img
      src={lightUrl}
      width={WIDTH}
      height={HEIGHT}
      alt="trek's home screen in a terminal: the change's trek is ready, with 19 steps and one step flagged likely wrong, listed with two more treks."
    />
  </picture>
  <figcaption>The home screen in a terminal, with sample data.</figcaption>
</figure>

<style>
  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    box-shadow: 0 1.5rem 3rem -1.5rem rgba(7, 11, 36, 0.45);
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
