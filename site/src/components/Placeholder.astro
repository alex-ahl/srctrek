---
// Stands in for a capture until the real screens and the editor clip are recorded.
interface Props {
  label: string
}

const { label } = Astro.props
---

<figure class="placeholder" aria-label={label}>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .placeholder {
    margin: 0;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    border: 1px dashed var(--border);
    border-radius: 0.9rem;
    background:
      radial-gradient(circle at 30% 30%, var(--hero-glow), transparent 70%), var(--bg-raised);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>
