---
interface Props {
  title: string
}

const { title } = Astro.props
---

<li>
  <h3>{title}</h3>
  <p><slot /></p>
</li>

<style>
  li {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    padding: 1.4rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  h3 {
    font-size: 1.1rem;
  }

  p {
    color: var(--text-muted);
  }
</style>
